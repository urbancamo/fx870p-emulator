10 MODE 8:DIM:GOSUB 500:c$=CHR$(5):m=2:k=1:n=1:x=0
20 CLS:PRINT "Cumulative frequency H(x,n,M,N)";
30 z=m:s$="N":GOSUB 400:m=z:IF m<2 THEN 30
40 z=k:s$="M":GOSUB 400:k=z:IF k>m THEN 40
50 z=n:s$="n":GOSUB 400:n=z:IF n>m-k THEN 50
60 z=x:s$="x":GOSUB 400:x=z:IF x>n OR x>k THEN 60
65 LOCATE 0,1:PRINT c$;".....";
70 sr=0:GOSUB "LIB0:S6330":GOSUB 500:IF sr THEN*
75 IF s THEN s=ROUND(s,LOG(ABS s)-6)
80 PRINT c$;"p=";s;:z$=INPUT$(1,@):GOTO 30
400 LOCATE 0,1:PRINT c$;s$;"=";z;"?";:INPUT @10;z:LOCATE 0,0:IF z<0 OR FRAC z<>0 THEN 400 ELSE RETURN
500 ON ERROR GOTO 510:RETURN
510 IF ERR=1 THEN CLS:ON ERROR GOTO 0
520 IF ERL=400 THEN RESUME 400
530 LOCATE 0,1:PRINT c$;"not found";:z$=INPUT$(1,@):RESUME 20
