60 LOCATE 8,1:INPUT @6;x$:LOCATE 0,0:x=VALF(LEFT$(x$,6)):v=ABS x:IF x<0 OR v>30 THEN 410
80 LOCATE 17,1:PRINT " .....";:GOSUB 200
