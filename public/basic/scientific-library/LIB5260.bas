115 IF r<>0 AND ABS r<1e-90 THEN r=r*1e10:r=ROUND(r,LOG(ABS r)-7):r=r/1e10
120 LOCATE 18,1:PRINT "     ";:LOCATE 17,1:PRINT r;:z$=INPUT$(1,@):GOTO 30
200 IF v+u=0 THEN r=1:RETURN
210 IF v=0 THEN r=0:RETURN
220 k=INT(1+3*v^(1/12)+9*v^(1/3)+(ABS(u-v)+ABS(u+v))/2)
