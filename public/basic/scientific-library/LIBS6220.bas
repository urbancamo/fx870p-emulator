10 GOSUB 400:IF x=<0 THEN p=1:GOTO 80
20 IF n>100 THEN z=x:x=((x/n)^(1/3)-(1-2/9/n))/SQR(2/9/n):GOSUB "LIB0:S6210":GOSUB 400:p=y:x=z:GOTO 80
30 IF x>400 THEN p=0:GOTO 80
40 a=EXP(-x/2):p=a:y=2
50 IF n MOD 2<>0 THEN z=x:x=SQR x:GOSUB "LIB0:S6210":GOSUB 400:p=2*y:a=SQR(2/PI)*a/x:x=z:y=1
60 FOR i=y TO n-2 STEP 2:a=a*x/i:p=p+a:NEXT
80 y=p:RETURN
400 ON ERROR GOTO 500:RETURN
500 IF ERR=1 THEN CLS:ON ERROR GOTO 0
510 sr=1:RESUME 80
