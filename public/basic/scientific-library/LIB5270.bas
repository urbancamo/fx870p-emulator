240 a=2*k/x*b-c:k=k-1
250 IF k=1 THEN d=a
260 IF k=0 THEN 290
270 IF(k MOD 2)=0 THEN s=s+a:j=j+2*a*(-1)^(k/2-1)/k
280 c=b:b=a:GOTO 240
290 s=2*s+a:j=j/s
300 j=(a*(.577215664901+LN(v/2))/s+2*j)*2/PI
310 IF n=0 THEN r=j:RETURN
320 y=(d/s*j-2/PI/v)/a*s
330 IF u=1 THEN r=y:RETURN
340 FOR i=2 TO u:e=2*(i-1)*y/x-j:j=y:y=e:NEXT
350 r=e:RETURN
