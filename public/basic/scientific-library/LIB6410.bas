20 CLS:PRINT "Percentage points   N(0,1’)";
30 LOCATE 0,1:PRINT c$;"p=";p;"?";:INPUT @10;p:LOCATE 0,0:IF p=<0 OR p>=1 THEN 30
60 LOCATE 0,1:PRINT c$;".....";
