10 MODE 8:DIM:GOSUB 500:c$=CHR$(5):k=0:x=0:DEF CHR$(254)="424C300806"
20 CLS:PRINT "Cumulative frequency  P(x,þ)";
30 z=k:s$="þ":GOSUB 400:k=z:IF k<0 THEN 30
40 z=x:s$="x":GOSUB 400:x=z:IF x<0 OR FRAC x<>0 THEN 40
60 LOCATE 0,1:PRINT c$;".....";
70 sr=0:GOSUB "LIB0:S6320":GOSUB 500:IF sr THEN*
75 IF s THEN s=ROUND(s,LOG(ABS s)-6)
80 PRINT c$;"p=";s;:z$=INPUT$(1,@):GOTO 30
400 LOCATE 0,1:PRINT c$;s$;"=";z;"?";:INPUT @10;z:LOCATE 0,0:RETURN
500 ON ERROR GOTO 510:RETURN
510 IF ERR=1 THEN CLS:ON ERROR GOTO 0
520 IF ERL=400 THEN RESUME 400
530 LOCATE 0,1:PRINT c$;"not found";:z$=INPUT$(1,@):RESUME 20
