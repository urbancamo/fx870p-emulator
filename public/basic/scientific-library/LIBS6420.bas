10 GOSUB 400:IF p>1 OR p=<0 THEN*
15 IF p=1 THEN x=0:GOTO 80
20 IF n=1 THEN q=p:p=q/2:GOSUB "LIB0:S6410":GOSUB 400:x=y*y:p=q:GOTO 80
30 IF n=2 THEN x=-2*LN p:GOTO 80
40 GOSUB "LIB0:S6410":GOSUB 400:x=y:y=x*x:x=n+SQR(2*n)*x+2/3*(y-1)+x*(y-7)/9/SQR(2*n)-2/405/n*(y*(3*y+7)-16):IF x<0 THEN x=0
50 IF n>100 THEN 80
60 b=x:GOSUB 100:IF n<31 THEN IF ABS(b-x)>1E-4 THEN 60
80 y=x:RETURN
100 q=p:GOSUB "LIB0:S6220":GOSUB 400:p=y
110 z=EXP(((n-1)*LN(x/n)-LN(4*PI*x)+n-x-1/n/6)/2)
120 x=x+(p-q)/z:p=q:x=ROUND(x,-6):RETURN
400 ON ERROR GOTO 500:RETURN
