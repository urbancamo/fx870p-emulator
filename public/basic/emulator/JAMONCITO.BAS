10 CLEAR
20 DIM L$(50,10)
30 N=0:W=50:TF=0:DF=0:H=0:M=0:S=0:B=1:G=1:Y=26
40 CLS:PRINT "JAMONCITO FX V0.2"
45 PRINT "Set clock first!"
48 GOSUB 2500
50 REM === MAIN MENU ===
55 CLS:IF TF=1 THEN GOSUB 3360:PRINT W$;"  ";D$
60 PRINT "1=Log 2=Set 3=Exp 4=Abt"
65 PRINT "5=Plan 6=Clock 7=Prn 8=End"
70 INPUT "Choice";C$
75 C=VAL(C$)
80 IF C=1 THEN 210
85 IF C=2 THEN 800
90 IF C=3 THEN 900
95 IF C=4 THEN 1300
100 IF C=5 THEN 1350
105 IF C=6 THEN 1500
106 IF C=7 THEN 1550
110 IF C=8 THEN 1400
115 PRINT "Invalid":GOSUB 2500:GOTO 50
200 REM === LOG MENU ===
210 CLS:PRINT "1=New 2=List 3=Back"
215 INPUT "Choice";C$
220 C=VAL(C$)
225 IF C=1 THEN 300
230 IF C=2 THEN 600
235 IF C=3 THEN 50
240 PRINT "Invalid":GOSUB 2500:GOTO 210
300 REM === NEW CONTACT ===
305 IF TF=0 OR DF=0 THEN CLS:PRINT "SET DATE/TIME FIRST!":GOSUB 2500:GOTO 210
310 IF N>=50 THEN CLS:PRINT "LOG FULL!":GOSUB 2500:GOTO 210
315 N=N+1:CLS:PRINT "Contact #";N
320 GOSUB 2200:L$(N,1)=D$
325 GOSUB 2000:L$(N,2)=T$
330 INPUT "Callsign";L$(N,3)
335 INPUT "RST TX";L$(N,4)
340 INPUT "RST RX";L$(N,5)
345 INPUT "Maidenhead";L$(N,6)
350 CLS:PRINT "ACT:B=BOTA P=POTA S=SOTA"
355 PRINT "W=WWFF C=Cust N=None"
360 INPUT "Choice";A$
365 IF A$="N" THEN L$(N,7)="":GOTO 430
370 IF A$="B" THEN L$(N,7)="BOTA":GOTO 430
375 IF A$="P" THEN L$(N,7)="POTA":GOTO 430
380 IF A$="S" THEN L$(N,7)="SOTA":GOTO 430
385 IF A$="W" THEN L$(N,7)="WWFF":GOTO 430
390 IF A$="C" THEN INPUT "Custom ACT";L$(N,7):GOTO 430
395 PRINT "Invalid":GOSUB 2500:GOTO 350
430 INPUT "Freq (MHz)";L$(N,8)
435 CLS:PRINT "MODE:1=CW 2=SSB 3=FT8 4=RTTY 5=Cust"
440 INPUT "Choice";C$
445 C=VAL(C$)
450 IF C=1 THEN L$(N,9)="CW":GOTO 480
455 IF C=2 THEN L$(N,9)="SSB":GOTO 480
460 IF C=3 THEN L$(N,9)="FT8":GOTO 480
465 IF C=4 THEN L$(N,9)="RTTY":GOTO 480
470 IF C=5 THEN INPUT "Custom MODE";L$(N,9):GOTO 480
475 PRINT "Invalid":GOSUB 2500:GOTO 435
480 INPUT "Notes";L$(N,10)
485 CLS:PRINT "Logged OK"
490 PRINT "1=Next 2=Menu 3=Clock"
492 INPUT "Choice";C$
494 C=VAL(C$)
496 IF C=1 THEN 310
497 IF C=2 THEN 210
498 IF C=3 THEN 1500
499 GOTO 485
600 REM === LIST ===
605 IF N=0 THEN CLS:PRINT "No entries":GOSUB 2500:GOTO 210
610 J=1
615 CLS
620 FOR I=J TO J+2
625 IF I<=N THEN PRINT I;":";L$(I,3);" ";L$(I,2);" ";L$(I,1)
630 NEXT I
635 IF J+2<N THEN GOSUB 2500:J=J+3:GOTO 615
640 INPUT "Details (Y/N)";A$
645 IF A$="N" THEN 210
650 IF A$<>"Y" THEN 640
655 INPUT "Number";A$
658 I=VAL(A$)
660 IF I<1 OR I>N THEN PRINT "Invalid":GOSUB 2500:GOTO 640
665 CLS:PRINT "Date:";L$(I,1);" Time:";L$(I,2)
670 PRINT "Call:";L$(I,3);" RST:";L$(I,4);"/";L$(I,5)
675 PRINT "Grid:";L$(I,6);" ACT:";L$(I,7)
680 GOSUB 2500
685 CLS:PRINT "Freq:";L$(I,8);" Mode:";L$(I,9)
690 PRINT "Notes:";L$(I,10)
695 GOSUB 2500
700 CLS:PRINT "1=Another 2=Menu"
705 INPUT "Choice";C$
708 C=VAL(C$)
710 IF C=1 THEN 655
715 IF C=2 THEN 210
720 GOTO 700
800 REM === SETTINGS ===
805 CLS:IF TF=1 THEN GOSUB 3360:PRINT W$;"  ";D$
810 PRINT "1=Set D/T 2=Cal 3=Back"
815 INPUT "Choice";C$
820 C=VAL(C$)
825 IF C=1 THEN CLS:GOSUB 2200:GOSUB 2000:GOTO 805
830 IF C=2 THEN GOSUB 3600:GOTO 805
835 IF C=3 THEN 50
840 PRINT "Invalid":GOSUB 2500:GOTO 805
900 REM === EXPORT ===
905 IF N=0 THEN CLS:PRINT "No entries":GOSUB 2500:GOTO 50
910 ON ERROR GOTO 1150
915 CLS:PRINT "F=Floppy R=RS232 X=Back"
920 INPUT "Choice";E$
925 IF E$="F" THEN 950
930 IF E$="R" THEN 1000
935 IF E$="X" THEN 50
940 PRINT "Invalid":GOSUB 2500:GOTO 915
950 CLS:PRINT "FLOPPY EXPORT"
955 INPUT "Filename";F$
960 IF F$="" THEN F$="HAMLOG"
965 OPEN "0:"+F$ FOR OUTPUT AS #1
970 GOTO 1050
1000 CLS:PRINT "RS-232 EXPORT"
1005 OPEN "COM0:2" AS #1
1050 PRINT #1,"DATE,TIME,CALL,RSTTX,RSTRX,MAIDEN,ACT,FREQ,MODE,NOTES"
1055 FOR I=1 TO N
1060 PRINT #1,L$(I,1);",";L$(I,2);",";L$(I,3);",";L$(I,4);",";L$(I,5);",";L$(I,6);",";L$(I,7);",";L$(I,8);",";L$(I,9);",";L$(I,10)
1065 NEXT I
1070 CLOSE
1075 CLS:PRINT "Saved":GOSUB 2500:GOTO 50
1150 REM === ERROR HANDLER ===
1155 CLS
1160 IF E$="F" THEN PRINT "NO FLOPPY":GOTO 1180
1165 IF E$="R" THEN PRINT "NO RS-232":GOTO 1180
1170 PRINT "ERR";ERR;" LN";ERL
1180 GOSUB 2500
1185 RESUME 50
1300 REM === ABOUT ===
1305 CLS:PRINT "Jamoncito FX v0.2 2026 by EI3LH"
1310 PRINT "www.ei3lh.eu"
1315 GOSUB 2500:GOTO 50
1350 REM === PLAN ===
1355 CLS:PRINT "IARU Band Plans (Jul 2025)"
1360 PRINT "20m:14.000-14.350 40m:7.000-7.200"
1365 PRINT "80m:3.500-3.800  QRP CW: 3.560 7.030 14.060"
1370 GOSUB 2500:GOTO 50
1400 REM === EXIT ===
1405 CLS:PRINT "73! Press MODE 0 to quit"
1410 END
1500 REM === STANDBY CLOCK ===
1505 IF TF=0 THEN CLS:PRINT "Set time first (Menu 2)":GOSUB 2500:GOTO 50
1510 CLS:PRINT "STANDBY - any key = menu"
1515 GOSUB 3360:LOCATE 0,2:PRINT W$;"  ";D$;
1520 Q=0
1525 K$=INKEY$:IF K$<>"" THEN 50
1530 Q=Q+1:IF Q<W THEN 1525
1535 Q=0:GOSUB 3000
1540 GOSUB 3360:LOCATE 0,2:PRINT W$;"  ";D$;
1545 GOTO 1525
1550 REM === PRINT TO FP-40 ===
1555 CLS:IF N=0 THEN PRINT "No entries":GOSUB 2500:GOTO 50
1560 PRINT "1=All records 2=Range"
1565 INPUT "Choice";C$
1570 C=VAL(C$)
1575 IF C=1 THEN A=1:B=N:GOTO 1600
1580 IF C=2 THEN INPUT "Start";A:INPUT "End";B:GOTO 1600
1585 PRINT "Invalid":GOSUB 2500:GOTO 1555
1600 IF A<1 OR B>N OR A>B THEN PRINT "Invalid range":GOSUB 2500:GOTO 1555
1605 CLS:PRINT "Printer ready?"
1610 INPUT "Print? (Y/N)";P$
1615 IF P$="N" THEN 50
1620 IF P$<>"Y" THEN 1605
1625 CLS:PRINT "Printing..."
1630 LPRINT "JAMONCITO FX LOG"
1635 LPRINT "Date: ";D$
1640 LPRINT "Entries ";A;"-";B;" of ";N
1645 LPRINT "-------------------------------"
1650 FOR I=A TO B
1655 LPRINT "#";I;" ";L$(I,3)
1660 LPRINT " ";L$(I,1);" ";L$(I,2)
1665 LPRINT " RST ";L$(I,4);"/";L$(I,5);" ";L$(I,6)
1670 LPRINT " ";L$(I,7);" ";L$(I,8);"MHz ";L$(I,9)
1675 IF L$(I,10)<>"" THEN LPRINT " ";L$(I,10)
1680 LPRINT "-------------------------------"
1685 NEXT I
1690 LPRINT "END LOG"
1695 CLS:PRINT "Printed OK":GOSUB 2500:GOTO 50
2000 REM === TIME INPUT ===
2005 IF TF=1 THEN GOSUB 3300
2010 U$=T$:PRINT "Time now: ";T$
2015 INPUT "Time (HH:MM)";T$
2020 IF T$="" THEN T$=U$
2025 IF T$="" THEN 2150
2030 IF LEN(T$)=4 THEN T$=MID$(T$,1,2)+":"+MID$(T$,3,2)
2035 IF LEN(T$)<>5 THEN 2150
2040 IF MID$(T$,3,1)<>":" THEN 2150
2045 E=0:FOR I=1 TO 5
2050 IF I=3 THEN 2060
2055 X$=MID$(T$,I,1):IF X$<"0" OR X$>"9" THEN E=1
2060 NEXT I
2065 IF E=1 THEN 2150
2070 X=VAL(MID$(T$,1,2)):Z=VAL(MID$(T$,4,2))
2075 IF X<=23 AND Z<=59 THEN H=X:M=Z:S=0:TF=1:RETURN
2150 T$=U$:PRINT "Invalid time":GOSUB 2500:GOTO 2010
2200 REM === DATE INPUT ===
2205 V$=D$:PRINT "Date now: ";D$
2210 INPUT "Date (DD/MM/YY)";D$
2215 IF D$="" THEN D$=V$
2220 IF D$="" THEN 2350
2225 IF LEN(D$)=6 THEN D$=MID$(D$,1,2)+"/"+MID$(D$,3,2)+"/"+MID$(D$,5,2)
2230 IF LEN(D$)<>8 THEN 2350
2235 IF MID$(D$,3,1)<>"/" OR MID$(D$,6,1)<>"/" THEN 2350
2240 E=0:FOR I=1 TO 8
2245 IF I=3 OR I=6 THEN 2255
2250 X$=MID$(D$,I,1):IF X$<"0" OR X$>"9" THEN E=1
2255 NEXT I
2260 IF E=1 THEN 2350
2262 P=G:O=Y
2265 X=VAL(MID$(D$,1,2)):Z=VAL(MID$(D$,4,2))
2270 IF X<1 OR Z<1 OR Z>12 THEN 2350
2275 G=Z:Y=VAL(MID$(D$,7,2)):GOSUB 3450
2280 IF X>Z THEN G=P:Y=O:GOTO 2350
2290 B=X:DF=1:RETURN
2350 D$=V$:PRINT "Invalid date":GOSUB 2500:GOTO 2205
2500 INPUT "Press EXE";K$:RETURN
3000 REM === CLOCK TICK 1 SEC ===
3005 S=S+1:IF S<60 THEN RETURN
3010 S=0:M=M+1:IF M<60 THEN RETURN
3015 M=0:H=H+1:IF H<24 THEN RETURN
3020 H=0:IF DF=0 THEN RETURN
3025 B=B+1:GOSUB 3450
3030 IF B>Z THEN B=1:G=G+1
3035 IF G>12 THEN G=1:Y=Y+1
3040 IF Y>99 THEN Y=0
3045 GOSUB 3400
3050 RETURN
3300 REM === T$=HH:MM ===
3302 X=H:GOSUB 3500:T$=X$+":"
3305 X=M:GOSUB 3500:T$=T$+X$
3310 RETURN
3360 REM === W$=HH:MM:SS ===
3362 X=H:GOSUB 3500:W$=X$+":"
3365 X=M:GOSUB 3500:W$=W$+X$+":"
3370 X=S:GOSUB 3500:W$=W$+X$
3375 RETURN
3400 REM === D$=DD/MM/YY ===
3402 X=B:GOSUB 3500:D$=X$+"/"
3405 X=G:GOSUB 3500:D$=D$+X$+"/"
3410 X=Y:GOSUB 3500:D$=D$+X$
3415 RETURN
3450 REM === Z=DAYS IN MONTH G ===
3452 Z=31
3455 IF G=4 OR G=6 OR G=9 OR G=11 THEN Z=30
3460 IF G=2 THEN Z=28
3465 IF G=2 AND Y-INT(Y/4)*4=0 THEN Z=29
3470 RETURN
3500 REM === X$=2-DIGIT X ===
3502 X$=CHR$(48+INT(X/10))+CHR$(48+X-INT(X/10)*10):RETURN
3600 REM === CALIBRATE ===
3605 CLS:PRINT "Cal: EXE starts count,"
3610 PRINT "press any key at 60s."
3615 INPUT "Ready";K$
3620 CLS:PRINT "Counting... key at 60s"
3625 Q=0:C=0
3630 K$=INKEY$:IF K$<>"" THEN 3650
3635 Q=Q+1:IF Q<1000 THEN 3630
3640 Q=0:C=C+1:LOCATE 0,2:PRINT C;
3645 GOTO 3630
3650 X=(C*1000+Q)/60
3655 IF X<10 THEN CLS:PRINT "Too short":GOSUB 2500:RETURN
3660 W=INT(X+.5)
3665 CLS:PRINT "Rate=";W;"/sec"
3670 GOSUB 2500:RETURN

