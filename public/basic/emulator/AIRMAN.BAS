5807 IF K$="3" THEN RETURN
5808 IF K$<>"1" AND K$<>"2" THEN GOTO 5801
5810 CLS
5811 LOCATE 0,0:PRINT "RESERVES:";YF;"G AVAIL:";FA;"G"
5812 LOCATE 0,1:PRINT "BUY:$";FB;"/G SELL:$";FS;"/G"
5813 LOCATE 0,3:PRINT "HOW MANY GAL";:INPUT A
5814 IF A<1 THEN GOTO 5801
5815 IF K$="1" AND A>FA THEN GOTO 5810
5816 IF K$="1" AND MC<A*FB THEN GOTO 5810
5817 IF K$="2" AND A>YF THEN GOTO 5810
5820 IF K$="1" THEN YF=YF+A:MC=MC-(A*FB):FA=FA-A
5821 IF K$="2" THEN YF=YF-A:MC=MC+(A*FS):FA=FA+A
5822 GOTO 5801
6000 CLS
6001 LOCATE 3,0:PRINT "PLANE MARKET"
6002 LOCATE 0,1:PRINT "1=BUY  2=SELL"
6003 LOCATE 0,2:PRINT "3=SKIP TO NEXT SCREEN"
6004 LOCATE 0,3:PRINT "CHOICE";
6005 K$=INPUT$(1)
6006 IF K$="3" THEN RETURN
6007 IF K$="1" THEN GOTO 6020
6008 IF K$="2" THEN GOTO 6100
6009 GOTO 6000
