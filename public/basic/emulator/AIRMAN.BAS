6109 LOCATE 0,2:PRINT "Sell for $";MID$(STR$(INT(SP)),2);"?"
6110 LOCATE 0,3:PRINT "Y/N?";
6111 K$=INPUT$(1)
6112 IF K$<>"Y" THEN GOTO 6000
6113 MC=MC+SP:YA$="":YAR=0:YAC=0:YAP=0
6114 GOTO 6000
6200 CLS:LOCATE 7,0:PRINT "ORDERS"
6201 IF YA$<>"" THEN GOTO 6205
6202 LOCATE 0,2:PRINT "NO AIRCRAFT"
6203 LOCATE 0,3:PRINT "PRESS ANY KEY...";
6204 K$=INPUT$(1):RETURN
6205 L=2:NF=0
6210 IF L>15 THEN GOTO 6280
6211 FC=INT(AD(L)/10)+1
6212 IF AD(L)>YAR THEN L=L+1:GOTO 6210
6213 IF YF<FC THEN L=L+1:GOTO 6210
6214 OT=INT(RAN#*3)+1
6215 OQ=INT(RAN#*5)+1
6216 OV=INT(RAN#*(AD(L)*5))+AD(L)
6220 CLS:LOCATE 0,0:PRINT AN$(L)
6221 LOCATE 0,1
6222 IF OT=1 THEN PRINT "WANTS ";OQ;" FOODSTUFFS"
6223 IF OT=2 THEN PRINT "WANTS ";OQ;" MEDICINES"
6224 IF OT=3 THEN PRINT "WANTS ";OQ;" MACHINERY"
6225 LOCATE 0,2:PRINT "AT $";MID$(STR$(INT(OV)),2);" EACH"
6226 LOCATE 0,3:PRINT "Y=ACCEPT  N=SKIP";
6227 K$=INPUT$(1):NF=1
6229 IF K$<>"Y" THEN L=L+1:GOTO 6210
6230 YF=YF-FC:MC=MC+(OQ*OV)
6240 CLS:LOCATE 0,0:PRINT "DELIVERED TO:"
6241 LOCATE 0,1:PRINT AN$(L)
6242 LOCATE 0,2:PRINT "EARNED: $";MID$(STR$(INT(OQ*OV)),2)
6243 LOCATE 0,3:PRINT "PRESS ANY KEY...";:K$=INPUT$(1)
6244 RETURN
6280 IF NF<>0 THEN RETURN
6281 CLS:LOCATE 0,0:PRINT "ORDERS"
6282 LOCATE 0,1:PRINT "No suitable contracts"
6283 LOCATE 0,2:PRINT "available this turn."
6284 LOCATE 0,3:PRINT "PRESS ANY KEY...";:K$=INPUT$(1)
6285 RETURN
6400 IF YA$="" THEN RETURN
6401 CLS:LOCATE 4,0:PRINT "COMMUNICATIONS"
6402 LOCATE 0,3:PRINT "PRESS ANY KEY...";
6403 K$=INPUT$(1)
6404 N=INT(RAN#*3)+1:TD=0:CLS
6405 FOR A=1 TO N
6406 EI=INT(RAN#*20)+1
6407 LOCATE 0,A-1:PRINT MID$(EC$(EI),1,18);" ";ED(EI);" DMG"
6408 TD=TD+ED(EI)
6409 NEXT A
6410 LOCATE 0,3:PRINT "TOTAL:";TD;" COST:$";TD*100;
6411 K$=INPUT$(1)
6420 IF TD>10 THEN GOTO 6450
6421 IF MC>=TD*100 THEN MC=MC-(TD*100):RETURN
6422 IF MD>=TD*100 THEN MD=MD-(TD*100):RETURN
6423 GOTO 6460
6450 CLS
6451 LOCATE 0,0:PRINT "CRASH! COST: $10000"
6452 IF MC>=10000 THEN MC=MC-10000:LOCATE 0,3:PRINT "PRESS ANY KEY...";:K$=INPUT$(1):RETURN
6453 IF MD>=10000 THEN MD=MD-10000:LOCATE 0,3:PRINT "PRESS ANY KEY...";:K$=INPUT$(1):RETURN
6454 GOTO 6460
6460 CLS
6461 LOCATE 4,0:PRINT "GAME OVER"
6462 LOCATE 0,1:PRINT "Insufficient funds for"
6463 LOCATE 0,2:PRINT "repairs. GOODBYE!"
6464 LOCATE 0,3:PRINT "PRESS ANY KEY...";
6465 K$=INPUT$(1)
6466 GV=1:RETURN
7000 PL=INT(MC+MD)-TW
7001 CLS
7002 LOCATE 5,0:PRINT "END OF TURN ";T
7003 LOCATE 0,1
