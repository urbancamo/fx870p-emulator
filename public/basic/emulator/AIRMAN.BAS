6021 LOCATE 0,0:PRINT "1=";PN$(1);" $";MID$(STR$(PP(1)),2)
6022 LOCATE 0,1:PRINT "2=";PN$(2);" $";MID$(STR$(PP(2)),2)
6023 LOCATE 0,2:PRINT "3=";PN$(3);" $";MID$(STR$(PP(3)),2)
6024 LOCATE 0,3:PRINT "4=MORE  5=CANCEL";
