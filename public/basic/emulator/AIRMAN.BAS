5636 IF L=2 THEN YP$="MEDIUM":YPV=4000:YPS=5:MC=MC-4000
5637 IF L=3 THEN YP$="LARGE":YPV=9000:YPS=10:MC=MC-9000
5638 GOTO 5600
5700 CLS
5701 LOCATE 3,0:PRINT "SELL PROPERTY"
5702 IF YP$<>"" THEN GOTO 5706
5703 LOCATE 0,2:PRINT "YOU OWN NO PROPERTY"
5704 LOCATE 0,3:PRINT "PRESS ANY KEY...";
5705 K$=INPUT$(1):GOTO 5600
5706 LOCATE 0,1:PRINT "You own: ";YP$
5707 LOCATE 0,2:PRINT "Sell? ($";YPV-500;" after fee)"
5708 LOCATE 0,3:PRINT "Y/N";
