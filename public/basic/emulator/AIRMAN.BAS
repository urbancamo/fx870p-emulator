5710 IF K$<>"Y" THEN GOTO 5600
5711 MC=MC+(YPV-500):YP$="":YPV=0:YPS=0
5712 GOTO 5600
5800 FB=INT(RAN#*50)+10:FS=INT(RAN#*50)+20
5801 CLS
5802 LOCATE 4,0:PRINT "FUEL MARKET"
5803 LOCATE 0,1:PRINT "RESERVES:";YF;"G AVAIL:";FA;"G"
5804 LOCATE 0,2:PRINT "BUY:$";FB;"/G SELL:$";FS;"/G"
5805 LOCATE 0,3:PRINT "1=BUY 2=SELL 3=SKIP";
