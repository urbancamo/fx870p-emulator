7007 LOCATE 0,3:PRINT "PRESS ANY KEY...";
7008 K$=INPUT$(1)
7009 RETURN
9000 FOR L=1 TO 5
9001 READ PN$(L),PP(L),PC(L),PR(L),PSP(L)
9002 NEXT L
9003 RETURN
