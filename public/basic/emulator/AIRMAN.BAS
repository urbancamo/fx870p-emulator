5492 SA(L)=SA(L)+A
5493 IF L=1 THEN YS1=YS1-A
5494 IF L=2 THEN YS2=YS2-A
5495 IF L=3 THEN YS3=YS3-A
5496 GOTO 5470
5600 CLS
5601 LOCATE 3,0:PRINT "PROPERTY MARKET"
5602 LOCATE 0,1:PRINT "1=BUY  2=SELL"
5603 LOCATE 0,2:PRINT "3=SKIP TO NEXT SCREEN"
5604 LOCATE 0,3:PRINT "CHOICE";
5605 K$=INPUT$(1)
5606 IF K$="3" THEN RETURN
5607 IF K$="1" THEN GOTO 5620
5608 IF K$="2" THEN GOTO 5700
5609 GOTO 5600
5620 CLS
5621 IF YP$="" THEN GOTO 5625
5622 LOCATE 0,0:PRINT "ALREADY OWN:";YP$
5623 LOCATE 0,3:PRINT "PRESS ANY KEY...";
5624 K$=INPUT$(1):GOTO 5600
5625 LOCATE 0,0:PRINT "1=SMALL  $1000  2 SPC"
5626 LOCATE 0,1:PRINT "2=MEDIUM $4000  5 SPC"
5627 LOCATE 0,2:PRINT "3=LARGE  $9000 10 SPC"
5628 LOCATE 0,3:PRINT "CHOICE";
5629 K$=INPUT$(1)
5630 IF K$<"1" OR K$>"3" THEN GOTO 5620
5631 L=VAL(K$)
5632 IF L=1 AND MC<1000 THEN GOTO 5620
5633 IF L=2 AND MC<4000 THEN GOTO 5620
5634 IF L=3 AND MC<9000 THEN GOTO 5620
