6061 CLS:LOCATE 0,0:PRINT "ALREADY HAVE PLANE:"
6062 LOCATE 0,1:PRINT YA$
6063 LOCATE 0,3:PRINT "PRESS ANY KEY...";:K$=INPUT$(1):GOTO 6000
6064 IF MC>=PP(L) THEN GOTO 6068
6065 CLS:LOCATE 0,1:PRINT "INSUFFICIENT FUNDS"
6066 LOCATE 0,3:PRINT "PRESS ANY KEY...";:K$=INPUT$(1):GOTO 6000
