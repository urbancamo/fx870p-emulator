5006 IF YA$<>"" THEN PRINT YA$
5007 LOCATE 0,2:PRINT "FUEL:";YF;"G FOOD:";YS1
5008 LOCATE 0,3:PRINT "MED:";YS2;" MACH:";YS3;
5009 K$=INPUT$(1)
5010 CLS
5011 LOCATE 7,0:PRINT "ACCOUNTS"
5012 LOCATE 0,1:PRINT "DEPOSIT : $";MID$(STR$(INT(MD)),2)
5013 LOCATE 0,2:PRINT "CURRENT : $";MID$(STR$(INT(MC)),2)
5014 LOCATE 0,3:PRINT "TURN:";T;" [ANY KEY]";
