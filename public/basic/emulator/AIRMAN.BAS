5016 RETURN
5100 CLS
5101 LOCATE 6,0:PRINT "OPTIONS"
5102 LOCATE 0,1:PRINT "1=ACCOUNTS  2=STOCKS"
5103 LOCATE 0,2:PRINT "3=PROPERTY  4=FUEL"
5104 LOCATE 0,3:PRINT "5=PLANES    6=CONT.";
5105 K$=INPUT$(1)
5106 IF K$="1" THEN GOSUB 5200
5107 IF K$="2" THEN GOSUB 5400
5108 IF K$="3" THEN GOSUB 5600
5109 IF K$="4" THEN GOSUB 5800
5110 IF K$="5" THEN GOSUB 6000
5111 IF K$<>"6" THEN GOTO 5100
5112 RETURN
5200 MD=MD+INT(MD*(MR/100))
5201 CLS
5202 LOCATE 5,0:PRINT "ACCOUNTS"
5203 LOCATE 0,1:PRINT "DEP:$";MID$(STR$(INT(MD)),2);" AT ";MR;"%"
5204 LOCATE 0,2:PRINT "CUR:$";MID$(STR$(INT(MC)),2)
5205 LOCATE 0,3:PRINT "1>CUR 2>DEP 3=SKIP";
5206 K$=INPUT$(1)
5207 IF K$="3" THEN RETURN
5208 IF K$<>"1" AND K$<>"2" THEN GOTO 5201
5209 CLS:LOCATE 0,0:PRINT "DEP:$";MID$(STR$(INT(MD)),2)
5210 LOCATE 0,1:PRINT "CUR:$";MID$(STR$(INT(MC)),2)
5211 LOCATE 0,3:PRINT "AMOUNT? ";:INPUT A
5212 IF A<1 THEN GOTO 5201
5213 IF K$="1" THEN GOTO 5230
5220 IF A>MC THEN GOTO 5201
5221 MD=MD+A:MC=MC-A:GOTO 5201
5230 IF A>MD THEN GOTO 5201
5231 MC=MC+A:MD=MD-A:GOTO 5201
5400 CLS
5401 LOCATE 2,0:PRINT "STOCK EXCHANGE"
5402 LOCATE 0,1:PRINT "FOOD  BUY:$";SB(1);" SELL:$";SS(1)
5403 LOCATE 0,2:PRINT "MED   BUY:$";SB(2);" SELL:$";SS(2)
5404 LOCATE 0,3:PRINT "MACH  BUY:$";SB(3);" SELL:$";SS(3);
5405 K$=INPUT$(1)
5410 CLS
5411 LOCATE 0,0:PRINT "1=BUY STOCKS"
5412 LOCATE 0,1:PRINT "2=SELL STOCKS"
5413 LOCATE 0,2:PRINT "3=SKIP"
5414 LOCATE 0,3:PRINT "CHOICE?";
5415 K$=INPUT$(1)
5416 IF K$="3" THEN RETURN
5417 IF K$="1" THEN GOTO 5430
5418 IF K$="2" THEN GOTO 5470
5419 GOTO 5410
5430 CLS
5431 LOCATE 4,0:PRINT "BUY STOCKS"
5432 LOCATE 0,1:PRINT "1=";SN$(1);" (";YS1;")"
5433 LOCATE 0,2:PRINT "2=";SN$(2);" (";YS2;")"
5434 LOCATE 0,3:PRINT "3=";SN$(3);"  4=BACK";
5435 K$=INPUT$(1)
5436 IF K$="4" THEN GOTO 5410
5437 IF K$<"1" OR K$>"3" THEN GOTO 5430
5438 L=VAL(K$)
5440 CLS
5441 LOCATE 0,0:PRINT SN$(L);" $";MID$(STR$(SB(L)),2)
5442 LOCATE 0,1:PRINT "AVAIL:";SA(L)
5443 LOCATE 0,2:PRINT "YOU HAVE:";
5444 IF L=1 THEN PRINT YS1
5445 IF L=2 THEN PRINT YS2
5446 IF L=3 THEN PRINT YS3
5447 LOCATE 0,3:PRINT "HOW MANY";:INPUT A
5448 IF A<1 OR A>SA(L) THEN GOTO 5440
5449 IF MC<INT(SB(L)*A) THEN GOTO 5440
5450 MC=MC-INT(SB(L)*A)
5451 SA(L)=SA(L)-A
5452 IF L=1 THEN YS1=YS1+A
5453 IF L=2 THEN YS2=YS2+A
5454 IF L=3 THEN YS3=YS3+A
5455 GOTO 5430
5470 CLS
5471 LOCATE 4,0:PRINT "SELL STOCKS"
5472 LOCATE 0,1:PRINT "1=";SN$(1);" (";YS1;")"
5473 LOCATE 0,2:PRINT "2=";SN$(2);" (";YS2;")"
5474 LOCATE 0,3:PRINT "3=";SN$(3);"  4=BACK";
5475 K$=INPUT$(1)
5476 IF K$="4" THEN GOTO 5410
5477 IF K$<"1" OR K$>"3" THEN GOTO 5470
5478 L=VAL(K$)
5480 CLS
5481 LOCATE 0,0:PRINT SN$(L);" $";MID$(STR$(SS(L)),2)
5482 LOCATE 0,1:PRINT "YOU HAVE:";
5483 IF L=1 THEN PRINT YS1
5484 IF L=2 THEN PRINT YS2
5485 IF L=3 THEN PRINT YS3
5486 LOCATE 0,3:PRINT "HOW MANY";:INPUT A
5487 IF A<1 THEN GOTO 5480
5488 IF L=1 AND A>YS1 THEN GOTO 5480
5489 IF L=2 AND A>YS2 THEN GOTO 5480
5490 IF L=3 AND A>YS3 THEN GOTO 5480
