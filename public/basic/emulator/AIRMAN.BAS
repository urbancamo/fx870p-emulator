6074 LOCATE 0,2:PRINT YA$
6075 LOCATE 0,3:PRINT "PRESS ANY KEY...";:K$=INPUT$(1)
6076 GOTO 6000
6100 CLS
6101 LOCATE 4,0:PRINT "SELL PLANE"
6102 IF YA$<>"" THEN GOTO 6106
6103 LOCATE 0,2:PRINT "YOU OWN NO PLANE"
6104 LOCATE 0,3:PRINT "PRESS ANY KEY...";
6105 K$=INPUT$(1):GOTO 6000
6106 LOCATE 0,1:PRINT "You own: ";YA$
6107 SP=YAP-(T*250)
