1 REM CALENDAR
2 REM CASIO FX-870P PORT
3 REM ORIGINAL: M.ERZBERGER
4 CLEAR:DIM M$(12)
5 RESTORE 900:FOR I=1 TO 12:READ M$(I):NEXT I
10 CLS:LOCATE 0,0:PRINT "Enter date:";
11 LOCATE 0,1:INPUT "YYYY-MM-DD? ";D$
12 IF LEN(D$)<>10 THEN 10
20 Y=VAL(LEFT$(D$,4)):M=VAL(MID$(D$,6,2)):D=VAL(RIGHT$(D$,2))
21 IF M<1 OR M>12 THEN 10
30 L=0:IF Y-INT(Y/4)*4=0 THEN L=1
31 IF Y-INT(Y/100)*100=0 THEN L=0
32 IF Y-INT(Y/400)*400=0 THEN L=1
40 RESTORE 920:FOR I=1 TO M:READ N:NEXT I
41 IF M=2 AND L=1 THEN N=29
42 IF D<1 OR D>N THEN 10
50 M2=M:Y2=Y
51 IF M2<3 THEN M2=M2+12:Y2=Y2-1
52 K=Y2-INT(Y2/100)*100:J=INT(Y2/100)
53 H=1+INT(13*(M2+1)/5)+K+INT(K/4)+INT(J/4)-2*J
54 H=H-INT(H/7)*7:IF H<0 THEN H=H+7
55 S=H-2:IF S<0 THEN S=S+7
100 CLS:PRINT "Printing..."
101 LPRINT M$(M);" ";STR$(Y)
102 LPRINT " Mo Tu We Th Fr Sa Su"
110 C=S
111 FOR I=1 TO S:LPRINT "   ";:NEXT I
120 FOR I=1 TO N
121 LPRINT RIGHT$("  "+STR$(I),3);
122 C=C+1:IF C<7 THEN 126
123 LPRINT:C=0
126 NEXT I
127 IF C>0 THEN LPRINT
128 LPRINT
200 W=S+D-1:W=W-INT(W/7)*7
201 RESTORE 940:FOR I=0 TO W:READ W$:NEXT I
210 Z$=INPUT$(1):CLS
211 PRINT D$;" is":PRINT W$
220 Z$=INPUT$(1):GOTO 10
900 DATA "January","February","March","April","May","June"
910 DATA "July","August","September","October","November","December"
920 DATA 31,28,31,30,31,30,31,31,30,31,30,31
940 DATA "Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"
