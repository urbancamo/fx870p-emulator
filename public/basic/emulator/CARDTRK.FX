1 REM 3-PILE CARD TRICK
2 REM FROM SHARP PC-1600
3 REM BY ALVIN BANDERAS
10 CLEAR:CLS
11 PRINT ">> CARD TRICK <<";
12 LOCATE 0,1:PRINT "THINK OF A CARD";
13 LOCATE 0,2:PRINT "THEN PICK COLUMN";
14 LOCATE 0,3:PRINT " ANY KEY TO START";
15 K$=INPUT$(1)
20 DIM C(36),P(36)
25 Q$="6 7 8 9 10J Q K A "
30 FOR I=1 TO 36:C(I)=I:NEXT I
35 FOR I=36 TO 2 STEP -1
40 J=INT(RAN#*I)+1
45 H=C(I):C(I)=C(J):C(J)=H
50 NEXT I
55 FOR Z=1 TO 3
60 FOR F=0 TO 11
65 CLS:PRINT "RD";Z;"DEAL";F+1;"/12";
70 LOCATE 0,1:PRINT "(1)    (2)    (3)";
75 FOR G=1 TO 3
80 K=C(F*3+G)
85 P((G-1)*12+F+1)=K
90 S=INT((K-1)/9)+1:L=K-(S-1)*9
95 N$=MID$(Q$,L*2-1,2)+CHR$(231+S)
100 LOCATE (G-1)*7,2:PRINT N$;
105 NEXT G
110 LOCATE 0,3:PRINT "  ANY KEY=NEXT";
115 K$=INPUT$(1)
120 NEXT F
125 CLS:PRINT "WHICH COLUMN HAS";
130 LOCATE 0,1:PRINT "YOUR CARD?";
135 LOCATE 0,2:PRINT "PRESS 1, 2, OR 3";
140 K$=INPUT$(1)
145 W=VAL(K$):IF W<1 OR W>3 THEN 140
150 IF W=2 THEN 170
155 FOR I=1 TO 12
160 H=P((W-1)*12+I):P((W-1)*12+I)=P(I+12):P(I+12)=H
165 NEXT I
170 FOR I=1 TO 36:C(I)=P(I):NEXT I
175 NEXT Z
180 K=C(18)
185 S=INT((K-1)/9)+1:L=K-(S-1)*9
190 N$=MID$(Q$,L*2-1,2)+CHR$(231+S)
195 CLS:PRINT " YOUR CARD IS...";
200 LOCATE 8,2:PRINT N$;
205 LOCATE 0,3:PRINT "  ANY KEY=END";
210 K$=INPUT$(1)
215 CLS:END