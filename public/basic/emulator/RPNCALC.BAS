1 REM RPN CALCULATOR
2 REM HP-STYLE 4-LEVEL STACK
3 REM +-*/ SWAP NEG CLR
10 CLEAR:CLS
11 PRINT "=== RPN CALCULATOR ===";
12 LOCATE 0,1:PRINT "0-9. +-*/ EXE=PUSH";
13 LOCATE 0,2:PRINT "C=CLR S=SWP N=+/-";
14 LOCATE 0,3:PRINT "PRESS ANY KEY...";
15 K$=INPUT$(1)
20 T=0:Z=0:Y=0:X=0:N$="":E=0
100 REM DISPLAY
110 CLS
120 LOCATE 0,0:PRINT "T:";T;
130 LOCATE 0,1:PRINT "Z:";Z;
140 LOCATE 0,2:PRINT "Y:";Y;
150 IF E=1 THEN LOCATE 0,3:PRINT ">";N$;"_"; ELSE LOCATE 0,3:PRINT "X:";X;
200 REM INPUT
210 K$=INPUT$(1):K=ASC(K$)
220 IF K>=48 AND K<=57 THEN E=1:N$=N$+K$:GOTO 100
230 IF K$="." THEN E=1:N$=N$+".":GOTO 100
240 IF K=13 THEN GOSUB 400:GOTO 100
250 IF K$="+" THEN GOSUB 450:X=Y+X:GOSUB 480:GOTO 100
260 IF K$="-" THEN GOSUB 450:X=Y-X:GOSUB 480:GOTO 100
270 IF K$="*" THEN GOSUB 450:X=Y*X:GOSUB 480:GOTO 100
280 IF K$="/" THEN GOSUB 560:GOTO 100
290 IF K$="C" OR K$="c" THEN X=0:N$="":E=0:GOTO 100
300 IF K$="S" OR K$="s" THEN W=X:X=Y:Y=W:GOTO 100
310 IF K$="N" OR K$="n" THEN GOSUB 500:GOTO 100
320 IF K=8 THEN GOSUB 520:GOTO 100
330 GOTO 200
400 REM ENTER
410 T=Z:Z=Y:Y=X
420 IF E=1 THEN X=VAL(N$):N$="":E=0
430 RETURN
450 REM FINISH ENTRY
460 IF E=0 THEN RETURN
470 T=Z:Z=Y:Y=X:X=VAL(N$):N$="":E=0:RETURN
480 REM DROP STACK
490 Y=Z:Z=T:T=0:RETURN
500 REM NEGATE
505 IF E=0 THEN X=-X:RETURN
510 IF LEFT$(N$,1)="-" THEN N$=MID$(N$,2):RETURN
515 N$="-"+N$:RETURN
520 REM BACKSPACE
530 IF E=1 AND LEN(N$)>0 THEN N$=LEFT$(N$,LEN(N$)-1)
540 IF LEN(N$)=0 THEN E=0
550 RETURN
560 REM DIVIDE
570 GOSUB 450
580 IF X=0 THEN RETURN
590 X=Y/X:GOSUB 480:RETURN
