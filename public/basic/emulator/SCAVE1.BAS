8460 DIM SV(7),CA(7)
8470 FOR I=0 TO 7:READ SV(I):NEXT I
8480 DATA 1,1,3,3,3,6,3,3
8490 REM -- Cave pack counts --
8500 DIM CK(13)
8510 FOR I=0 TO 13:READ CK(I):NEXT I
8520 DATA 0,1,3,2,0,0,0,0,3,3,3,1,2,1
8600 REM -- Treasure --
8610 DIM TP(14),TW(14),TK(14),TN$(14)
8620 FOR I=0 TO 14
8630   READ TP(I),TW(I),TK(I)
8640 NEXT I
8650 DATA 5,25,6,10,25,6,20,25,3
8660 DATA 15,0,1,5,0,1,5,0,1,5,0,1
8670 DATA 10,0,1,5,0,1,15,0,1,30,0,1
8680 DATA 20,0,1,10,0,1,0,0,1,0,100,1
8690 FOR I=0 TO 14:READ TN$(I):NEXT I
8700 DATA "SILVER","GOLD","GEMS"
8710 DATA "M.SWD","M.CRPT","L.DUST"
8720 DATA "H.BALM","TALSMN","S.POTN"
8730 DATA "M.STAF","RING","L.RUBY"
8740 DATA "C.FLUT","EYE","CHEST"
8750 REM -- Hazards --
8760 DIM HK(4),HN$(4)
8770 FOR I=0 TO 4:READ HK(I):NEXT I
8780 DATA 1,2,1,1,1
