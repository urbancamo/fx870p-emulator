100 REM ===========================
110 REM  SORCERER'S CAVE - Stg 1
120 REM  Title, Party, Map, Move
130 REM ===========================
140 REM Run CLEAR 8192 before RUN
150 GOSUB 8000:REM LOAD DATA
160 GOSUB 500:REM SETUP
170 REM ---- MAIN LOOP ----
180 IF GS<>0 THEN 7000
190 GOSUB 7500:REM STATUS
200 GOSUB 250:REM ACTION
210 GOTO 180
250 REM ---- GET ACTION ----
260 AC=MP(PA):GOSUB 9100
270 GOSUB 9300:REM EXIT STRING
280 LOCATE 0,3
290 PRINT EX$;" Mv I ? X      ";
300 K$=INKEY$:IF K$="" THEN 300
310 IF K$="I" OR K$="i" THEN GOSUB 7620:GOTO 250
320 IF K$="?" THEN GOSUB 7800:GOTO 250
330 DR=0
340 IF K$="N" OR K$="n" THEN DR=1
350 IF K$="E" OR K$="e" THEN DR=2
360 IF K$="S" OR K$="s" THEN DR=3
370 IF K$="W" OR K$="w" THEN DR=4
380 IF K$="U" OR K$="u" THEN DR=5
390 IF K$="D" OR K$="d" THEN DR=6
400 IF K$="X" OR K$="x" THEN GOSUB 7900:RETURN
410 IF DR=0 THEN 300
420 REM Validate exit
430 IF DR=1 AND AN=0 THEN BEEP 0:GOTO 300
440 IF DR=2 AND AE=0 THEN BEEP 0:GOTO 300
450 IF DR=3 AND AZ=0 THEN BEEP 0:GOTO 300
460 IF DR=4 AND AW=0 THEN BEEP 0:GOTO 300
470 IF DR=5 AND AU=0 THEN BEEP 0:GOTO 300
480 IF DR=6 AND AD=0 THEN BEEP 0:GOTO 300
490 GOSUB 1000:REM MOVE
495 TN=TN+1:RETURN
500 REM ==== SETUP ====
510 GOSUB 600:REM TITLE
520 GOSUB 700:REM PICK PARTY
530 GOSUB 850:REM INIT DECKS
540 GOSUB 950:REM INIT MAP
550 GS=0:TN=1:NC=0:SK=0:SC=0
560 RETURN
600 REM ---- TITLE SCREEN ----
610 CLS
620 LOCATE 2,0
630 PRINT CHR$(135);" SORCERER'S CAVE ";CHR$(135)
640 LOCATE 2,1
650 PRINT "A Game of Exploration"
660 LOCATE 4,2
670 PRINT "Magic and Adventure"
680 LOCATE 7,3
690 PRINT "[EXE] to begin"
695 GOSUB 9400:RETURN
700 REM ---- PICK PARTY ----
710 RP=6:NP=0
720 FOR I=0 TO 7:CA(I)=SV(I):NEXT I
730 CI=0
740 REM Show creature
750 CLS:LOCATE 0,0
760 PRINT "PARTY Pts:";RP;" ";
770 IF NP>0 THEN FOR I=0 TO NP-1:PRINT CN$(PC(I));" ";:NEXT I
780 LOCATE 0,1
790 PRINT CN$(CI);" F:";CF(CI);" M:";CM(CI);" ";
800 LOCATE 0,2
810 PRINT "Car:";CC(CI)*25;"kg Sel:";CV(CI);" x";CA(CI);"  "
820 LOCATE 0,3
830 PRINT "[EXE]Add [4/6]Nxt [0]Go ";
835 K$=INKEY$:IF K$="" THEN 835
836 IF K$="6" THEN CI=CI+1:IF CI>7 THEN CI=0
837 IF K$="4" THEN CI=CI-1:IF CI<0 THEN CI=7
838 IF K$="0" AND NP>0 THEN 900
839 IF K$<>CHR$(13) THEN 740
840 REM Add creature
841 IF CV(CI)>RP THEN BEEP 0:GOTO 740
842 IF CA(CI)<=0 THEN BEEP 0:GOTO 740
843 PC(NP)=CI:PS(NP)=0:PK(NP)=0
844 FOR J=0 TO 4:PT(NP,J)=-1:NEXT J
845 NP=NP+1:RP=RP-CV(CI)
846 CA(CI)=CA(CI)-1
847 IF RP<=0 THEN 900
848 GOTO 740
850 REM ---- INIT DECKS ----
852 FOR I=0 TO 59:LP(I)=I+1:NEXT I
854 FOR I=59 TO 1 STEP -1
856   J=INT(RAN#*(I+1))
858   T=LP(I):LP(I)=LP(J):LP(J)=T
860 NEXT I:LI=0
862 REM Build small pack
864 SN=0
866 FOR I=0 TO 13
868   FOR J=1 TO CK(I)
870     SP(SN)=100+I:SN=SN+1
872   NEXT J:NEXT I
874 FOR I=0 TO 14
876   FOR J=1 TO TK(I)
878     SP(SN)=200+I:SN=SN+1
880   NEXT J:NEXT I
882 FOR I=0 TO 4
884   FOR J=1 TO HK(I)
886     SP(SN)=300+I:SN=SN+1
888   NEXT J:NEXT I
890 REM Shuffle small pack
892 FOR I=SN-1 TO 1 STEP -1
894   J=INT(RAN#*(I+1))
896   T=SP(I):SP(I)=SP(J):SP(J)=T
898 NEXT I:RETURN
900 REM -- Confirm party --
905 CLS:PRINT "YOUR PARTY:"
910 FOR I=0 TO NP-1
915   PRINT CN$(PC(I));"(";CF(PC(I));") ";
920 NEXT I:PRINT
930 PRINT "[EXE]Begin [BS]Redo";
935 K$=INKEY$:IF K$="" THEN 935
940 IF K$=CHR$(8) THEN 710
945 IF K$=CHR$(13) THEN RETURN
947 GOTO 935
950 REM ---- INIT MAP ----
955 FOR I=0 TO 60
960   MP(I)=0:MX(I)=0:MY(I)=0
965   ML(I)=0:MV(I)=0:MS(I)=0
970 NEXT I
975 REM Place GATEWAY
980 MP(1)=AK(0):MX(1)=0:MY(1)=0
985 ML(1)=1:MV(1)=1:NM=1
990 PA=1:PL=1:PD=0:RETURN
1000 REM ==== MOVEMENT ====
1010 REM DR=direction (1-6)
1020 DX=0:DY=0
1030 IF DR=1 THEN DY=-1
1040 IF DR=2 THEN DX=1
1050 IF DR=3 THEN DY=1
1060 IF DR=4 THEN DX=-1
1070 REM Check existing area
1080 FA=0
1090 IF DR>=5 THEN 1150:REM Stairs
1100 TX=MX(PA)+DX:TY=MY(PA)+DY
1110 FOR I=1 TO NM
1120   IF ML(I)=PL AND MX(I)=TX AND MY(I)=TY THEN FA=I:I=NM
1130 NEXT I
1140 IF FA>0 THEN PA=FA:PL=ML(FA):RETURN
1150 REM Stairs - check link
1160 IF MS(PA)>0 THEN PA=MS(PA):PL=ML(PA):RETURN
1170 REM Draw new area card
1180 IF LI>59 THEN CLS:PRINT "Pack exhausted!":GOSUB 9400:RETURN
1190 NC=AK(LP(LI)):LI=LI+1
1200 REM Check matching exit
1210 AC=NC:GOSUB 9100
1220 OK=0
1230 IF DR=1 AND AZ>0 THEN OK=1
1240 IF DR=2 AND AW>0 THEN OK=1
1250 IF DR=3 AND AN>0 THEN OK=1
1260 IF DR=4 AND AE>0 THEN OK=1
1270 IF DR>=5 THEN OK=1
1280 IF OK=0 THEN GOSUB 1400:RETURN
1290 REM Place card
1300 NM=NM+1:FA=NM
1310 MP(NM)=NC
1320 IF DR<=4 THEN MX(NM)=MX(PA)+DX:MY(NM)=MY(PA)+DY:ML(NM)=PL
1330 IF DR=5 THEN MX(NM)=MX(PA):MY(NM)=MY(PA):ML(NM)=PL-1
1340 IF DR=6 THEN MX(NM)=MX(PA):MY(NM)=MY(PA):ML(NM)=PL+1
1350 MV(NM)=1
1360 IF DR>=5 THEN MS(PA)=NM:MS(NM)=PA
1370 PA=NM:PL=ML(NM)
1380 REM Check type
1390 AC=NC:GOSUB 9100
1392 IF AT=3 THEN CLS:PRINT CHR$(135);" VIPER PIT!":PRINT "(Stage 2)":GOSUB 9400
1394 IF AT=2 THEN CLS:PRINT CHR$(135);" DEEP POOL!":PRINT "(Stage 2)":GOSUB 9400
1396 IF AH=1 THEN CLS:PRINT CHR$(236);" CHAMBER entered!":PRINT "(Stage 2)":GOSUB 9400
1398 RETURN
1400 REM -- DEAD END --
1410 CLS
1420 PRINT CHR$(134);" DEAD END!"
1430 PRINT "No matching exit."
1440 NM=NM+1
1450 MP(NM)=NC:MV(NM)=0
1460 IF DR<=4 THEN MX(NM)=MX(PA)+DX:MY(NM)=MY(PA)+DY:ML(NM)=PL
1470 PRINT "[EXE] Continue";
1480 GOSUB 9400:RETURN
7000 REM ==== END GAME ====
7010 CLS
7020 IF GS=1 THEN PRINT CHR$(135);" ESCAPED!"
7030 IF GS=2 THEN PRINT "Your party perished..."
7040 PRINT "Score: ";SC
7050 PRINT
7060 PRINT "[EXE] Play again";
7070 GOSUB 9400
7080 GOTO 150
7100 REM ---- CALC SCORE ----
7110 SC=0
7120 FOR I=0 TO NP-1
7130   SC=SC+CP(PC(I))
7140   IF PK(I)>0 THEN SC=SC+CP(PC(I))
7150 NEXT I
7160 FOR I=0 TO NP-1
7170   FOR J=0 TO 4
7180     IF PT(I,J)>=0 THEN SC=SC+TP(PT(I,J))
7190   NEXT J
7200 NEXT I
7210 IF SK THEN SC=SC+30
7220 SC=SC-NC*30
7230 IF SC<0 THEN SC=0
7240 RETURN
7500 REM ==== STATUS DISPLAY ====
7510 CLS
7520 AC=MP(PA):GOSUB 9100
7530 LOCATE 0,0
7540 PRINT "L";PL;" ";
7550 IF AT=1 THEN PRINT "GATEWAY";
7555 IF AT=2 THEN PRINT "DEEP POOL";
7560 IF AT=3 THEN PRINT "VIPER PIT";
7565 IF AT=4 THEN PRINT "TOMB";
7570 IF AT=5 THEN PRINT "GRT HALL";
7575 IF AT=0 AND AH=1 THEN PRINT "Chmb#";PA;
7580 IF AT=0 AND AH=0 THEN PRINT "Tnl#";PA;
7585 PRINT " T";TN
7590 REM Line 2: Exits
7591 LOCATE 0,1
7592 PRINT "Ex:";
7593 IF AN THEN PRINT "N";
7594 IF AE THEN PRINT "E";
7595 IF AZ THEN PRINT "S";
7596 IF AW THEN PRINT "W";
7597 IF AU THEN PRINT " ";CHR$(238);"Up";
7598 IF AD THEN PRINT " ";CHR$(238);"Dn";
7599 PRINT "  "
7601 REM Line 3: Party
7602 LOCATE 0,2
7603 FOR I=0 TO NP-1
7604   IF I<3 THEN PRINT CN$(PC(I));" ";
7605 NEXT I
7606 IF NP>3 THEN PRINT "+";NP-3;
7607 PRINT "  "
7610 RETURN
7620 REM ---- INVENTORY ----
7621 VI=0
7622 CLS:PRINT "INVENTORY  Party:";NP
7624 FOR I=VI TO VI+1
7626   IF I>=NP THEN 7630
7628   PRINT CN$(PC(I));"(";CF(PC(I));")";CC(PC(I))*25;"kg"
7630 NEXT I
7632 PRINT "[EXE]Back [4/6]Scroll  ";
7634 K$=INKEY$:IF K$="" THEN 7634
7636 IF K$="6" THEN VI=VI+2:IF VI>=NP THEN VI=0
7638 IF K$="4" THEN VI=VI-2:IF VI<0 THEN VI=0
7640 IF K$=CHR$(13) THEN RETURN
7642 GOTO 7622
7800 REM ---- HELP ----
7810 CLS
7820 PRINT "N/E/S/W = Move direction"
7830 PRINT "U/D = Stairs up/down"
7840 PRINT "I=Inventory X=Exit cave"
7850 PRINT "[EXE] Return";
7860 GOSUB 9400:RETURN
7900 REM ---- EXIT CAVE ----
7910 AC=MP(PA):GOSUB 9100
7920 IF PL<>1 OR AU=0 THEN BEEP 0:RETURN
7930 CLS
7940 PRINT "Leave the cave?"
7950 PRINT "You cannot return!"
7960 PRINT "[Y]es  [N]o";
7970 K$=INKEY$:IF K$="" THEN 7970
7980 IF K$="Y" OR K$="y" THEN GS=1:GOSUB 7100
7990 RETURN
8000 REM ==== LOAD DATA ====
8010 REM -- Area cards --
8020 DIM AK(60)
8030 FOR I=0 TO 60:READ AK(I):NEXT I
8040 DATA 191,23,73,23,79
8050 DATA 543,671,287,31,15
8060 DATA 25,23,9,7,11
8070 DATA 415,9,43,75,9
8080 DATA 9,159,39,71,14
8090 DATA 31,27,25,66,22
8100 DATA 14,5,69,31,23
8110 DATA 25,22,47,46,11
8120 DATA 10,78,31,3,78
8130 DATA 27,6,72,15,7
8140 DATA 27,37,23,13,13
8150 DATA 12,78,6,5,12,25
8200 REM -- Creature stats --
8210 DIM CF(13),CM(13),CC(13)
8220 DIM CV(13),CP(13),CG(13)
8230 DIM CN$(13)
8240 FOR I=0 TO 13
8250   READ CF(I),CM(I),CC(I),CV(I),CP(I),CG(I)
8260 NEXT I
8270 DATA 3,0,3,6,10,3
8280 DATA 4,0,2,5,10,7
8290 DATA 5,0,4,5,5,16
8300 DATA 4,0,3,4,4,16
8310 DATA 2,2,1,4,8,1
