8330 DATA 2,0,1,2,5,5
8340 DATA 1,0,1,1,2,25
8350 DATA 2,5,0,0,15,1
8360 DATA 0,5,0,0,0,0
8370 DATA 6,0,0,0,0,16
8380 DATA 4,9,0,0,0,0
8390 DATA 7,0,6,0,7,16
8395 DATA 0,4,0,0,4,16
8400 FOR I=0 TO 13:READ CN$(I):NEXT I
