8795 DATA "MUTINY","TRAP","QUAKE","MEDUSA","GHOULS"
8800 REM -- Game arrays --
8810 DIM MP(60),MX(60),MY(60)
8820 DIM ML(60),MV(60),MS(60)
8830 DIM LP(59),SP(60)
8840 DIM PC(12),PS(12),PK(12)
8850 DIM PT(12,4)
8860 FOR I=0 TO 12:FOR J=0 TO 4
8870   PT(I,J)=-1
8880 NEXT J:NEXT I
8890 RETURN
9100 REM == DECODE AREA CARD ==
9110 AN=AC AND 1
9120 AE=(AC AND 2)/2
9130 AZ=(AC AND 4)/4
9140 AW=(AC AND 8)/8
9150 AH=(AC AND 16)/16
9160 AU=(AC AND 32)/32
9170 AD=(AC AND 64)/64
9180 AT=INT((AC AND 896)/128)
9190 RETURN
9300 REM == BUILD EXIT STRING ==
9310 EX$=""
9320 IF AN THEN EX$=EX$+"N"
9330 IF AE THEN EX$=EX$+"E"
9340 IF AZ THEN EX$=EX$+"S"
9350 IF AW THEN EX$=EX$+"W"
9360 IF AU THEN EX$=EX$+"U"
9370 IF AD THEN EX$=EX$+"D"
9380 RETURN
9400 REM == WAIT EXE ==
9410 K$=INKEY$:IF K$="" THEN 9410
9420 IF K$<>CHR$(13) THEN 9410
9430 RETURN
9500 REM == ROLL DIE ==
9510 D=INT(RAN#*6)+1
9520 RETURN
