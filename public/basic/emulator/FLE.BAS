10 REM FLE LOGGER
20 REM FAST LOG ENTRY FOR HAM RADIO
30 REM CASIO FX-870P
40 CLEAR
50 ON ERROR GOTO 9000
60 B$="":M$="":F$="":P$="":Q$=""
70 C$="":O$="":D$="":R$="":A$=""
80 REM CHECK FOR EXISTING LOG
90 RESTORE#
92 E=0:READ# L$:IF E=1 THEN GOTO 100
94 CLS
96 LOCATE 0,0:PRINT "EXISTING LOG FOUND"
98 LOCATE 0,2:PRINT "RESUME? (Y/N)";
99 K$=INPUT$(1):IF K$="Y" OR K$="y" THEN GOTO 900
100 REM === MAIN MENU ===
110 CLS
120 LOCATE 5,0:PRINT "FLE LOGGER v1.0"
130 LOCATE 0,1:PRINT "1=NEW  2=VIEW  3=CLEAR"
140 LOCATE 0,2:PRINT "4=DOWNLOAD  5=QUIT"
150 LOCATE 0,3:PRINT "CHOICE(1-5)";
160 INPUT A
170 IF A<1 OR A>5 THEN GOTO 100
180 IF A=1 THEN GOTO 300
190 IF A=2 THEN GOTO 1000
200 IF A=3 THEN GOTO 1100
210 IF A=4 THEN GOTO 1200
220 IF A=5 THEN END
230 GOTO 100
300 REM === NEW LOG PREAMBLE ===
310 CLS
320 LOCATE 0,0:PRINT "=== NEW LOG ==="
330 LOCATE 0,2:PRINT "CALLSIGN";
340 INPUT C$
350 IF C$="" THEN GOTO 310
360 CLS
370 LOCATE 0,0:PRINT "OPERATOR";
380 INPUT O$
390 IF O$="" THEN O$=C$
400 CLS
410 LOCATE 0,0:PRINT "DATE (YYYY-MM-DD)";
420 INPUT D$
430 IF D$="" THEN GOTO 400
440 CLS
450 LOCATE 0,0:PRINT "ACTIVITY:"
460 LOCATE 0,1:PRINT "(N)ONE (P)OTA (S)OTA (W)WFF"
470 LOCATE 0,3:PRINT "CHOICE";
480 A$=INPUT$(1)
490 IF A$="N" OR A$="n" THEN A$="":GOTO 560
500 IF A$="P" OR A$="p" THEN A$="P":GOTO 520
510 IF A$="S" OR A$="s" THEN A$="S":GOTO 520
512 IF A$="W" OR A$="w" THEN A$="W":GOTO 520
514 GOTO 440
520 CLS
530 IF A$="P" THEN LOCATE 0,0:PRINT "POTA REFERENCE";
540 IF A$="S" THEN LOCATE 0,0:PRINT "SOTA REFERENCE";
550 IF A$="W" THEN LOCATE 0,0:PRINT "WWFF REFERENCE";
552 INPUT R$
554 IF R$="" THEN GOTO 520
560 REM WRITE PREAMBLE TO MEMO
570 WRITE# "mycall "+C$
580 WRITE# "operator "+O$
590 WRITE# "date "+D$
600 IF A$="P" THEN WRITE# "mypota "+R$
610 IF A$="S" THEN WRITE# "mysota "+R$
620 IF A$="W" THEN WRITE# "mywwff "+R$
630 GOTO 700
700 REM === ENTRY LOOP ===
710 GOSUB 2000
720 LOCATE 0,3:PRINT ">                              ";
730 LOCATE 1,3
740 INPUT L$
750 IF L$="q" OR L$="Q" THEN GOTO 100
760 GOSUB 2200
770 WRITE# L$
780 P$=Q$:Q$=L$
790 GOTO 700
900 REM === RESUME LOG ===
910 RESTORE#
920 E=0:READ# L$:IF E=1 THEN GOTO 100
930 IF LEFT$(L$,7)="mycall " THEN C$=MID$(L$,8)
940 IF LEFT$(L$,9)="operator " THEN O$=MID$(L$,10)
950 IF LEFT$(L$,5)="date " THEN D$=MID$(L$,6)
960 IF LEFT$(L$,7)="mypota " THEN R$=MID$(L$,8):A$="P"
970 IF LEFT$(L$,7)="mysota " THEN R$=MID$(L$,8):A$="S"
980 IF LEFT$(L$,7)="mywwff " THEN R$=MID$(L$,8):A$="W"
990 GOSUB 2200
992 P$=Q$:Q$=L$
994 E=0:READ# L$:IF E=1 THEN GOTO 700
996 GOTO 930
1000 REM === VIEW LOG ===
1010 RESTORE#
1020 CLS
1030 N=0
1040 E=0:READ# L$:IF E=1 THEN GOTO 1080
1050 LOCATE 0,N:PRINT LEFT$(L$,32);
1060 N=N+1
1070 IF N<4 THEN GOTO 1040
1072 K$=INPUT$(1)
1074 IF K$="q" OR K$="Q" THEN GOTO 100
1076 CLS:N=0:GOTO 1040
1080 IF N>0 THEN LOCATE 0,3:PRINT "[END OF LOG]";:K$=INPUT$(1)
1090 GOTO 100
1100 REM === CLEAR LOG ===
1110 CLS
1120 LOCATE 0,0:PRINT "CLEAR ALL LOG DATA?"
1130 LOCATE 0,2:PRINT "(Y/N)";
1140 K$=INPUT$(1)
1150 IF K$<>"Y" AND K$<>"y" THEN GOTO 100
1160 RESTORE#
1170 E=0:READ# L$:IF E=1 THEN GOTO 100
1180 RESTORE# L$,1
1190 WRITE#
1192 GOTO 1160
1200 REM === DOWNLOAD VIA COM0 ===
1210 CLS
1220 LOCATE 0,0:PRINT "DOWNLOADING..."
1230 OPEN "COM0:6,N,8,1,N,N,N,N,N" FOR OUTPUT AS #1
1240 RESTORE#
1250 E=0:READ# L$:IF E=1 THEN GOTO 1280
1260 PRINT #1,L$
1270 GOTO 1250
1280 CLOSE
1290 LOCATE 0,2:PRINT "DOWNLOAD COMPLETE"
1292 LOCATE 0,3:PRINT "PRESS ANY KEY...";
1294 K$=INPUT$(1)
1296 GOTO 100
2000 REM === REFRESH DISPLAY ===
2010 CLS
2020 S$=C$
2030 IF R$<>"" THEN S$=S$+" "+R$
2040 IF B$<>"" THEN S$=S$+" "+B$
2050 IF M$<>"" THEN S$=S$+" "+M$
2060 IF F$<>"" THEN S$=S$+" "+F$
2070 LOCATE 0,0:PRINT LEFT$(S$,32);
2080 LOCATE 0,1:PRINT LEFT$(P$,32);
2090 LOCATE 0,2:PRINT LEFT$(Q$,32);
2100 RETURN
2200 REM === PARSE BAND/FREQ/MODE ===
2210 REM EXTRACT FIRST TOKEN
2220 I=1:T$=""
2230 IF I>LEN(L$) THEN GOTO 2280
2240 IF MID$(L$,I,1)=" " THEN GOTO 2280
2250 T$=T$+MID$(L$,I,1):I=I+1:GOTO 2230
2260 REM
2270 REM
2280 REM LOWERCASE THE TOKEN
2290 U$=""
2300 FOR J=1 TO LEN(T$):U$=U$+CHR$(ASC(MID$(T$,J,1)) OR 32):NEXT J
2310 REM CHECK IF FIRST TOKEN IS A BAND
2320 IF U$="2m" OR U$="4m" OR U$="6m" OR U$="10m" OR U$="12m" OR U$="15m" THEN GOTO 2400
2330 IF U$="17m" OR U$="20m" OR U$="30m" OR U$="40m" OR U$="60m" THEN GOTO 2400
2340 IF U$="80m" OR U$="160m" OR U$="70cm" OR U$="23cm" THEN GOTO 2400
2350 GOTO 2600
2400 REM BAND DECLARATION LINE
2410 B$=U$:M$="":F$=""
2420 REM PARSE REMAINING TOKENS FOR MODE AND FREQ
2430 IF I>LEN(L$) THEN RETURN
2440 IF MID$(L$,I,1)=" " THEN I=I+1:GOTO 2430
2450 T$=""
2460 IF I>LEN(L$) THEN GOTO 2500
2470 IF MID$(L$,I,1)=" " THEN GOTO 2500
2480 T$=T$+MID$(L$,I,1):I=I+1:GOTO 2460
2500 REM LOWERCASE AND CHECK
2510 V$=""
2520 FOR J=1 TO LEN(T$):V$=V$+CHR$(ASC(MID$(T$,J,1)) OR 32):NEXT J
2530 IF V$="ssb" OR V$="cw" OR V$="fm" OR V$="am" OR V$="dv" THEN M$=V$:GOTO 2430
2540 REM CHECK FOR FREQ (CONTAINS DOT)
2550 FOR J=1 TO LEN(T$)
2560 IF MID$(T$,J,1)="." THEN F$=T$:GOTO 2430
2570 NEXT J
2580 GOTO 2430
2600 REM QSO LINE - SCAN FOR INLINE FREQ
2610 IF I>LEN(L$) THEN RETURN
2620 IF MID$(L$,I,1)=" " THEN I=I+1:GOTO 2610
2630 T$=""
2640 IF I>LEN(L$) THEN GOTO 2680
2650 IF MID$(L$,I,1)=" " THEN GOTO 2680
2660 T$=T$+MID$(L$,I,1):I=I+1:GOTO 2640
2680 FOR J=1 TO LEN(T$)
2690 IF MID$(T$,J,1)="." THEN F$=T$:RETURN
2700 NEXT J
2710 GOTO 2610
9000 REM === ERROR HANDLER ===
9010 E=1:RESUME NEXT
