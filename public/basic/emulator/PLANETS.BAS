1 REM PLANETARY POSITIONS
2 REM CASIO FX-870P
3 REM MEEUS ALGORITHMS
4 CLEAR:DIM N$(9),Z(9,5)
5 ANGLE 1:REM radians mode
6 K=PI/180
7 FOR I=1 TO 9:READ N$(I):NEXT I
8 DATA "Sun","Moon","Mercury","Venus","Mars"
9 DATA "Jupiter","Saturn","Uranus","Neptune"
10 CLS:PRINT "PLANET POSITIONS"
11 INPUT "Year (1583+)=";Y
12 IF Y<1583 THEN PRINT "Bad year":GOTO 11
13 INPUT "Month (1-12)=";M
14 IF M<1 OR M>12 THEN PRINT "Bad month":GOTO 13
15 INPUT "Day (1-31)=";D
16 IF D<1 OR D>31 THEN PRINT "Bad day":GOTO 15
17 INPUT "Hour (0-23 UT)=";U
18 IF U<0 OR U>23 THEN PRINT "Bad hour":GOTO 17
19 D=D+U/24
20 REM --- JULIAN DATE ---
21 IF M>2 THEN 24
22 Y=Y-1:M=M+12
24 A=INT(Y/100):B=2-A+INT(A/4)
25 J=INT(365.25*(Y+4716))+INT(30.6001*(M+1))+D+B-1524.5
26 T=(J-2451545)/36525
27 H=(23.4393-.013*T)*K
28 REM --- GMST -> LST ---
29 S=280.46062+360.98565*(J-2451545)
30 S=S-INT(S/360)*360:IF S<0 THEN S=S+360
31 RESTORE 960:READ W,X
32 S=(S+X)*K:P=W*K
33 REM S=LST(rad), P=observer lat(rad)
35 REM --- EARTH POSITION ---
36 RESTORE 910
37 READ A,B,C,D,E,L,M,O
38 A=A+B*T:A=A-INT(A/360)*360:A=A*K
39 E=E+L*T:E=E-INT(E/360)*360:E=E*K
40 B=A-E:L=(2*D-D^3/4)*SIN(B)+1.25*D*D*SIN(2*B)
41 V=B+L:R=C*(1-D*D)/(1+D*COS(V))
42 F=V+E:G=R
43 REM F=Earth helio lon(rad), G=Earth dist(AU)
44 CLS:PRINT "Computing..."
45 RESTORE 950:FOR N=1 TO 9:READ Z(N,5):NEXT N
50 RESTORE 910
51 FOR I=1 TO 9
52   IF I=2 THEN GOSUB 150:GOTO 54
53   READ A,B,C,D,E,L,M,O:GOSUB 100
54 NEXT I
55 N=1
56 GOSUB 300
57 I$=INPUT$(1)
58 IF ASC(I$)=28 AND N<9 THEN N=N+1:GOTO 56
59 IF ASC(I$)=29 AND N>1 THEN N=N-1:GOTO 56
60 IF I$="Q" OR I$="q" THEN CLS:END
61 IF I$="R" OR I$="r" THEN 10
62 GOTO 57
95 REM NOTE: No perturbation corrections.
96 REM Jupiter ~2deg, Saturn ~3deg error.
97 REM Other planets: <1 degree accuracy.
100 REM --- PLANET COMPUTATION ---
101 A=A+B*T:A=A-INT(A/360)*360:A=A*K
102 E=E+L*T:E=E-INT(E/360)*360:E=E*K
103 M=M*K:O=O*K
104 IF I=1 THEN 120
105 B=A-E
106 L=(2*D-D^3/4)*SIN(B)+1.25*D*D*SIN(2*B)
107 V=B+L:R=C*(1-D*D)/(1+D*COS(V))
108 W=V+E
109 REM --- Inclination projection ---
110 B=ASN(SIN(W-O)*SIN(M))
111 X=COS(W-O):Y=SIN(W-O)*COS(M):GOSUB 400
112 W=O+U
113 REM --- Helio to Geocentric ---
114 X=R*COS(B)*COS(W)-G*COS(F)
115 Y=R*COS(B)*SIN(W)-G*SIN(F)
116 Q=R*SIN(B):Z(I,5)=Z(I,5)+5*LOG(R*SQR(X*X+Y*Y+Q*Q))
117 GOSUB 400:A=U
118 B=ATN(Q/SQR(X*X+Y*Y))
119 GOTO 130
120 REM --- Sun (geocentric = Earth + PI) ---
121 A=F+PI:B=0:Z(I,5)=Z(I,5)+5*LOG(G)
130 REM --- Ecliptic to Equatorial ---
131 X=COS(A):Y=SIN(A)*COS(H)-TAN(B)*SIN(H)
132 GOSUB 400:Z(I,1)=U/K
133 Z(I,2)=ASN(SIN(B)*COS(H)+COS(B)*SIN(H)*SIN(A))/K
134 REM --- Equatorial to Horizontal ---
135 Q=S-Z(I,1)*K
136 Z(I,3)=ASN(SIN(P)*SIN(Z(I,2)*K)+COS(P)*COS(Z(I,2)*K)*COS(Q))/K
137 X=COS(P)*TAN(Z(I,2)*K)-SIN(P)*COS(Q):Y=-SIN(Q)
138 GOSUB 400:Z(I,4)=U/K
139 IF Z(I,4)<0 THEN Z(I,4)=Z(I,4)+360
140 IF Z(I,1)<0 THEN Z(I,1)=Z(I,1)+360
141 RETURN
150 REM --- MOON COMPUTATION (Meeus Ch.47) ---
151 REM Fundamental arguments (degrees)
152 A=218.3165+481267.8813*T:A=A-INT(A/360)*360
153 D=297.8502+445267.1115*T:D=D-INT(D/360)*360
154 M=357.5291+35999.0503*T:M=M-INT(M/360)*360
155 O=134.9634+477198.8676*T:O=O-INT(O/360)*360
156 W=93.272+483202.0175*T:W=W-INT(W/360)*360
157 REM A=L' M=Msun O=M' W=F D=elong (degrees)
158 REM --- Ecliptic longitude ---
159 D=D*K:M=M*K:O=O*K:W=W*K
160 L=A+6.289*SIN(O)+1.274*SIN(2*D-O)+.658*SIN(2*D)
161 L=L+.214*SIN(2*O)-.186*SIN(M)-.114*SIN(2*W)
162 L=L-INT(L/360)*360
163 REM --- Ecliptic latitude ---
164 B=5.128*SIN(W)+.281*SIN(O+W)+.278*SIN(O-W)+.173*SIN(2*D-W)
165 REM --- Phase computation ---
166 REM Sun geocentric lon = F+PI (radians)
167 V=(F+PI)/K:V=V-INT(V/360)*360
168 REM Elongation = Moon lon - Sun lon
169 E=L-V:E=E-INT(E/360)*360:IF E<0 THEN E=E+360
170 Z(2,0)=E:REM save elongation for phase display
171 C=.5-.5*COS(E*K):IF C<.01 THEN Z(2,5)=0:GOTO 173
172 Z(2,5)=-12.7-2.5*LOG(C)
173 REM --- Convert to radians for coord transform ---
174 A=L*K:B=B*K
175 GOTO 130
180 REM --- MOON PHASE DISPLAY ---
181 E=Z(2,0):REM retrieve elongation
182 R=INT((.5-.5*COS(E*K))*100+.5)
183 IF R>98 THEN PRINT " Full ";R;"%";:RETURN
184 IF R<2 THEN PRINT " New ";R;"%";:RETURN
185 IF E<180 AND R<48 THEN PRINT " Wax Cres ";R;"%";:RETURN
186 IF E<180 AND R<52 THEN PRINT " 1st Qtr ";R;"%";:RETURN
187 IF E<180 THEN PRINT " Wax Gibb ";R;"%";:RETURN
188 IF R>=52 THEN PRINT " Wan Gibb ";R;"%";:RETURN
189 IF R>=48 THEN PRINT " 3rd Qtr ";R;"%";:RETURN
190 PRINT " Wan Cres ";R;"%";:RETURN
300 REM --- DISPLAY PLANET N ---
301 CLS
302 LOCATE 0,0:PRINT N$(N);
303 R=INT(Z(N,5)*10+.5)/10:PRINT " m";R;
304 IF N=2 THEN GOSUB 180:GOTO 309
305 IF Z(N,3)>=5 THEN PRINT " *vis*";
309 LOCATE 0,1
310 REM --- Format RA ---
311 R=Z(N,1)/15:IF R<0 THEN R=R+24
312 IF R>=24 THEN R=R-24
313 D=INT(R):M=INT((R-D)*60+.5)
314 IF M>=60 THEN M=0:D=D+1
315 IF D>=24 THEN D=D-24
316 PRINT "RA  ";RIGHT$(STR$(100+D),2);"h";
317 PRINT RIGHT$(STR$(100+M),2);"m";
318 REM --- Format Dec ---
319 LOCATE 16,1
320 R=Z(N,2):A$="+":IF R<0 THEN A$="-"
321 R=ABS(R):D=INT(R):M=INT((R-D)*60+.5)
322 IF M>=60 THEN M=0:D=D+1
323 PRINT "Dec ";A$;RIGHT$(STR$(100+D),2);CHR$(223);RIGHT$(STR$(100+M),2);"'";
324 REM --- Format Alt ---
325 LOCATE 0,2
326 R=Z(N,3):A$="+":IF R<0 THEN A$="-"
327 R=ABS(R):D=INT(R):M=INT((R-D)*60+.5)
328 IF M>=60 THEN M=0:D=D+1
329 PRINT "Alt ";A$;RIGHT$(STR$(100+D),2);CHR$(223);RIGHT$(STR$(100+M),2);"'";
330 REM --- Format Az ---
331 LOCATE 16,2
332 R=Z(N,4):D=INT(R):M=INT((R-D)*60+.5)
333 IF M>=60 THEN M=0:D=D+1
334 IF D>=360 THEN D=D-360
335 PRINT "Az  ";RIGHT$(STR$(1000+D),3);CHR$(223);RIGHT$(STR$(100+M),2);"'";
336 LOCATE 0,3
337 PRINT CHR$(228);"Prev ";CHR$(230);"Next  Q=End";
340 RETURN
400 REM ATN2: Y=y-arg, X=x-arg -> U
401 IF X=0 THEN U=SGN(Y)*PI/2:RETURN
402 U=ATN(Y/X)
403 IF X<0 THEN U=U+PI*SGN(Y):IF Y=0 THEN U=PI
404 RETURN
