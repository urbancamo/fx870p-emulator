5 REM MONSTER CHASE,PORTED FROM ORIGINAL
6 CASIO PB-700 VERSION BY ALVIN BANDERAS 2026
10 A=INT(RAN#*20+1):C=0:M=0:H=10
20 CLS:LOCATE M,0:PRINT "M";:LOCATE H,0:PRINT "H"
30 LOCATE 0,1: INPUT "GUESS(1-20)";B
35 C=C+1:IF B=A THEN GOTO 100
40 M=M+2:H=H+1
45 IF B<A THEN PRINT "TOO LOW! "
47 IF B>A THEN PRINT "TOO HIGH!"
50 W=15:GOSUB 300:IF M>=H THEN GOTO 200
60 GOTO 20
100 CLS:LOCATE 23,0:PRINT "H";:W=15:GOSUB 300:BEEP:W=60: GOSUB 300
110 CLS:PRINT "SAFE! YOU WIN!"
115 PRINT "IN ";C;" TRIES!":W=10:GOSUB 300:GOTO 10
200 CLS:LOCATE M,0:PRINT "*";:W=1:GOSUB 300:BEEP:W=10:GOSUB 300:BEEP
210 CLS:PRINT "MONSTER GOT YOU!":STOP
300 FOR I=0 TO W*30:NEXT I:RETURN
