{
  "name": "fx870p-emulator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite --port 3007 &",
    "stop": "lsof -ti :3007 | xargs kill -9",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "compile": "tsx tools/compiler/compile.ts",
    "dis": "tsx tools/dis.ts",
    "test": "vitest run"
  },
  "dependencies": {
